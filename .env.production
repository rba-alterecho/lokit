# Valores PUBLICOS de producao. Este ficheiro e commitado de proposito:
# nada aqui e segredo. Os segredos (SUPABASE_SERVICE_ROLE_KEY,
# TURNSTILE_SECRET_KEY, MAILJET_*) vivem nas "Variables and Secrets" do
# Worker, postos a mao no dashboard da Cloudflare, e o keep_vars no
# wrangler.jsonc impede que um deploy os apague.

NEXT_PUBLIC_SITE_URL=https://lokit.pt

# Preencher quando o projecto Supabase existir
NEXT_PUBLIC_SUPABASE_URL=

# Preencher quando o Turnstile estiver criado no dashboard da Cloudflare
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Token do Cloudflare Web Analytics (nao e segredo, aparece no HTML)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# A CSP arranca em Report-Only. Passar a "enforce" depois de uma semana de
# relatorios limpos. Ver docs/SECURITY.md.
CSP_MODE=report-only
