# Copiar para .env.local e preencher (SO para desenvolvimento local).
# O .env.local esta no .gitignore e nunca deve ser commitado.
#
# EM PRODUCAO (Cloudflare Worker):
#  - valores publicos (NEXT_PUBLIC_*) vivem em .env.production, commitado
#  - segredos vivem como Secret nas "Variables and Secrets" do Worker
#  Ver docs/SETUP.md.

# Base de dados (Supabase, regiao UE)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyXxxx...

# Anti-bot (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Envio de email (Mailjet)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=info@lokit.pt
MAIL_FROM_NAME=Lokit

# Para onde vao os avisos de lead novo e os alertas operacionais
LEADS_EMAIL=info@lokit.pt
ALERT_EMAIL=info@lokit.pt
# Segundo canal de alerta, opcional (webhook de Discord ou Slack)
ALERT_WEBHOOK_URL=

# CSP: "enforce" impoe, qualquer outro valor publica em Report-Only
CSP_MODE=report-only
CSP_REPORT_URI=

# URL publico do site (usado no sitemap, no JSON-LD e nos emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
